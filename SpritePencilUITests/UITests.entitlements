<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The runner inherits the app's sandbox otherwise, which walls it off from the directory it
	     shares with Scripts/screenshots.sh. A test runner has nothing to gain from being sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
