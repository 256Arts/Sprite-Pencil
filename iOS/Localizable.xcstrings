    "With the move tool, drag to select an area, then drag inside it to move only those pixels." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ziehe mit dem Werkzeug „Verschieben“, um einen Bereich auszuwählen, und ziehe dann innerhalb davon, um nur diese Pixel zu verschieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con la herramienta Mover, arrastra para seleccionar un área y luego arrastra dentro de ella para mover solo esos píxeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avec l'outil Déplacer, faites glisser pour sélectionner une zone, puis faites glisser à l'intérieur pour déplacer uniquement ces pixels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "移動ツールを使って、ドラッグして範囲を選択し、その範囲内をドラッグするとそのピクセルだけを移動できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用移动工具，拖动以选择区域，然后在区域内拖动以仅移动这些像素。"
          }
        }
      }
    },
